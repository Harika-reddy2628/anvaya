# Public, owner-confirmed contact information. Leave optional values empty.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_BEHANCE_URL=

# Server-only Resend settings. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
# Must use a domain verified in Resend.
PROJECT_ENQUIRY_FROM=
# Inbox that receives enquiries. Falls back to NEXT_PUBLIC_CONTACT_EMAIL.
PROJECT_ENQUIRY_TO=
